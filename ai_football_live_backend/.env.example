# ============================================================
# AI Football Live — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_football_live

# ---- Docker Compose PostgreSQL overrides ----
POSTGRES_DB=ai_football_live
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ---- Cache provider: memory | redis ----
CACHE_PROVIDER=memory

# ---- AI Provider: mock | groq | gemini ----
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.3

# ---- Groq ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=
GROQ_APP_MAX_REQUESTS_PER_MINUTE=30
GROQ_APP_MAX_REQUESTS_PER_DAY=14400

# ---- Gemini (Phase 2+) ----
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_APP_MAX_REQUESTS_PER_MINUTE=15
GEMINI_APP_MAX_REQUESTS_PER_DAY=1000000

# ---- CORS ----
CORS_ORIGINS=*

# ---- Football Data Provider: mock | api-football ----
FOOTBALL_PROVIDER=mock
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_TIMEOUT_SECONDS=10
FOOTBALL_POLL_INTERVAL_SECONDS=900
# Comma-separated league IDs to filter (leave empty for all)
FOOTBALL_LEAGUE_IDS=
# Season year (leave empty for current)
FOOTBALL_SEASON=

# ---- Backend ----
BACKEND_PORT=8000

# ---- Polling (Phase 2+) ----
LIVE_MATCH_POLL_INTERVAL_SECONDS=30
UPCOMING_MATCH_POLL_INTERVAL_SECONDS=300
