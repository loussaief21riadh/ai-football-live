# Database
DATABASE_URL=postgresql+asyncpg://localhost:5432/ai_football_live

# AI Provider
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
GROQ_APP_MAX_REQUESTS_PER_MINUTE=30
GROQ_APP_MAX_REQUESTS_PER_DAY=14400
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_APP_MAX_REQUESTS_PER_MINUTE=15
GEMINI_APP_MAX_REQUESTS_PER_DAY=1000000

# Cache
CACHE_PROVIDER=memory
REDIS_URL=redis://localhost:6379

# Polling (Phase 2+)
LIVE_MATCH_POLL_INTERVAL_SECONDS=30
UPCOMING_MATCH_POLL_INTERVAL_SECONDS=300
