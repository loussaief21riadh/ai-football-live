# ============================================================
# AI Football Live — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_football_live

# ---- Docker Compose PostgreSQL overrides ----
POSTGRES_DB=ai_football_live
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ---- Cache provider: memory | redis ----
CACHE_PROVIDER=memory

# ---- AI Provider: mock | groq | gemini ----
AI_PROVIDER=mock

# ---- Groq (Phase 2+) ----
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
GROQ_APP_MAX_REQUESTS_PER_MINUTE=30
GROQ_APP_MAX_REQUESTS_PER_DAY=14400

# ---- Gemini (Phase 2+) ----
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_APP_MAX_REQUESTS_PER_MINUTE=15
GEMINI_APP_MAX_REQUESTS_PER_DAY=1000000

# ---- CORS ----
CORS_ORIGINS=*

# ---- Backend ----
BACKEND_PORT=8000

# ---- Polling (Phase 2+) ----
LIVE_MATCH_POLL_INTERVAL_SECONDS=30
UPCOMING_MATCH_POLL_INTERVAL_SECONDS=300
